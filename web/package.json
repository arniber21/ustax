{
  "name": "ustax-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-provenance.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-provenance.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
