    "@shikijs/themes": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "ajv": "8.17.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.66.0",
    "radix-ui": "1.8.1",
    "react-day-picker": "10.0.2",
    "react-hook-form": "7.91.0",
    "react-markdown": "10.1.0",
    "react-router": "^7.18.5",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
