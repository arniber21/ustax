import UsTax.PtcFamily
import UsTax.Ptc.Table2Data

/-!
# Golden test: `ptcFamily` reproduces every row of Form 8962 Table 2

Same test as `catala/tests/test_ptc_table2.catala_en`, on the Lean code. For each of the 255
rows of `UsTax/Ptc/Table2Data.lean` (generated by `scripts/gen_lean_ptc_table2.py` from the
Catala test, whose rows were extracted from the printed Table 2, `i8962--2024.pdf` p 10), a
single filer in the 48 states with that household income as AGI must get the row's Worksheet 2
percentage (line 5) and the row's applicable figure (line 7). The checks are `#guard`s: the
build fails if any row differs. They run in the compiled evaluator, not the kernel.
-/

namespace UsTax.Ptc.Table2

open PtcFamily

/-- Lines 5 and 7 for a single filer with AGI `dollars`. -/
def lineOf (dollars : Int) : PtcFamilyOut := ptcFamily { base with agi := dollars * 100 }

/-- The rows whose percentage differs from the printed one. -/
def percentMismatches : List Row :=
  rows.filter fun r => (lineOf r.incomeDollars).householdIncomeAsPercent != (r.percent : Rat)

/-- The rows whose figure differs from the printed one. -/
def figureMismatches : List Row :=
  rows.filter fun r =>
    (lineOf r.incomeDollars).applicableFigure != (r.figureTenThousandths : Rat) / 10000

#guard rows.length == 255
#guard percentMismatches.length == 0
#guard figureMismatches.length == 0
-- Negative control: the comparison sees a one-point shift of the figure.
#guard (rows.filter fun r =>
    (lineOf r.incomeDollars).applicableFigure != ((r.figureTenThousandths + 1 : Int) : Rat) / 10000).length
  == 255

end UsTax.Ptc.Table2
