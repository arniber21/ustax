import UsTax.Defaults
import UsTax.Lists
import UsTax.Date
import Plausible

/-!
# Property tests for `Defaults`, `Lists`, `Date` (plausible)

Each statement was tested with plausible before its proof was written
(CLAUDE.md section 5). They run on every build as `#eval` checks; a
counterexample fails the build. Valid dates are generated by construction
(`mkDate` maps arbitrary numbers to a real date), not by filtering.
-/

namespace UsTax.HelpersProps
open Plausible UsTax UsTax.Date

local macro "#prop " p:term : command =>
  `(command| #eval Testable.check $p { numInst := 500 })

/-- A real date from arbitrary numbers. -/
def mkDate (y : Int) (m d : Nat) : Date :=
  let m' := m % 12 + 1
  { year := y, month := m', day := d % daysInMonth y m' + 1 }

#prop (∀ y : Int, ∀ m d : Nat, (mkDate y m d).Valid)
#prop (∀ y : Int, ∀ m d : Nat, (mkDate y m d).dayBefore.Valid)
#prop (∀ y : Int, ∀ m d : Nat, (mkDate y m d).dayBefore.year =
  if (mkDate y m d).month = 1 ∧ (mkDate y m d).day = 1 then y - 1 else y)
#prop (∀ t y : Int, ∀ m d : Nat, ageDayBefore t (mkDate y m d) =
  age t (mkDate y m d) + (if (mkDate y m d).month = 1 ∧ (mkDate y m d).day = 1 then 1 else 0))
#prop (∀ t y : Int, ∀ m d : Nat, age65OrOlder t (mkDate y m d) = true ↔
  (mkDate y m d).year ≤ t - 65 ∨
    ((mkDate y m d).year = t - 64 ∧ (mkDate y m d).month = 1 ∧ (mkDate y m d).day = 1))

-- Lists
#prop (∀ l : List Int, ∀ l' : List Int, Money.sum (l ++ l') = Money.sum l + Money.sum l')
#prop (∀ l : List Nat, 0 ≤ Money.sum (l.map (fun n : Nat => (n : Int))))
#prop (∀ l : List Int, Money.sumBy (fun x => x * x) l ≥ 0)
#prop (∀ l : List Int, Money.sumBy (fun x => x * x) (l.filter (fun x => x > 0)) ≤
  Money.sumBy (fun x => x * x) l)
#prop (∀ l : List Int, Money.countBy (fun x => decide (x > 0)) l ≤ l.length)

-- Defaults: disjoint conditions never conflict
#prop (∀ n : Int, (toyGroup n ==
  .ok (if n < 0 then some 1 else if 100 ≤ n then some 2 else some 0)) = true)

end UsTax.HelpersProps
