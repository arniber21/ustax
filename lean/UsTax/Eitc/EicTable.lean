import UsTax.Eitc
import UsTax.Eitc.EicTableData

/-!
# Golden test: `eitcTable` reproduces the printed 2024 EIC Table

Same tests as `catala/tests/test_eitc_table_golden.catala_en`, on the Lean code.

1. Each of the 1,337 rows `[atLeast, butLessThan)` of `UsTax/Eitc/EicTableData.lean`
   (generated by `scripts/gen_lean_eic_table.py` from
   `sources/forms-instructions/derived-eic-table-2024.csv`) is checked at its lowest and
   its highest whole dollar, with earned income equal to AGI, for all eight printed columns
   (single, head of household or qualifying surviving spouse, and married filing jointly,
   each with 0, 1, 2, 3 or more children): 21,392 evaluations. A column is not compared at
   an income at or above its completed phase-out amount, where the table prints "can't
   take the credit" (as in the Catala test); the number skipped is `#guard`ed.
2. The 3,000 (earned income, AGI) pairs of the Catala golden test, with the credit EIC
   Worksheet B gives (look up the earned income; if AGI differs and is at least the
   threshold, look up AGI too and take the smaller): `eitcTable` must give it.

The checks are `#guard`s: the build fails if any check fails. They run in the compiled
evaluator, not the kernel.
-/

namespace UsTax.Eitc.EicTable

/-- The eight printed columns of a row: (is joint, children, printed credit in dollars). -/
def columns (r : Row) : List (Bool × Int × Int) :=
  [(false, 0, r.s0), (false, 1, r.s1), (false, 2, r.s2), (false, 3, r.s3),
   (true, 0, r.mfj0), (true, 1, r.mfj1), (true, 2, r.mfj2), (true, 3, r.mfj3)]

/-- Every (income in dollars, joint, children, printed credit in dollars) evaluation of a row. -/
def evaluationsOf (r : Row) : List (Int × Bool × Int × Int) :=
  [r.atLeast, r.butLessThan - 1].flatMap fun x =>
    (columns r).map fun (mfj, n, printed) => (x, mfj, n, printed)

/-- All evaluations of the table. -/
def evaluations : List (Int × Bool × Int × Int) := rows.flatMap evaluationsOf

/-- The model's credit at `x` dollars of earned income and AGI. -/
def amountAt (x : Int) (mfj : Bool) (n : Int) : Int :=
  (eitcTable { earnedIncome := x * 100, agi := x * 100, isMfj := mfj, qualifyingChildren := n }).amount

/-- At or above the column's completed phase-out amount the table prints no credit. -/
def pastPhaseout (x : Int) (mfj : Bool) (n : Int) : Bool :=
  decide ((eitcTable { earnedIncome := x * 100, agi := x * 100, isMfj := mfj,
                       qualifyingChildren := n }).completedPhaseout ≤ x * 100)

/-- Evaluations that are compared (the column still prints a credit at `x`). -/
def compared : List (Int × Bool × Int × Int) :=
  evaluations.filter fun (x, mfj, n, _) => !pastPhaseout x mfj n

/-- The compared evaluations where the model differs from the printed table. -/
def rowFailures : List (Int × Bool × Int × Int) :=
  compared.filter fun (x, mfj, n, printed) => amountAt x mfj n != printed * 100

#guard rows.length = 1337
#guard evaluations.length = 21392
#guard compared.length = 15774
#guard evaluations.length - compared.length = 5618
#guard rowFailures.isEmpty

/-- The pairs where the model differs from the EIC Worksheet B result. -/
def pairFailures : List Pair :=
  pairs.filter fun p =>
    (eitcTable { earnedIncome := p.earnedIncome * 100, agi := p.agi * 100, isMfj := p.mfj
                 qualifyingChildren := (p.children : Int) }).amount != p.expected * 100

#guard pairs.length = 3000
#guard pairFailures.isEmpty

end UsTax.Eitc.EicTable
