import UsTax.TaxRates
import UsTax.TaxRates.TaxTableData

/-!
# Golden test: `tentativeTaxFor` reproduces the printed 2024 Tax Table

Same test as `catala/tests/test_tax_rates_table.catala_en`, on the Lean code.
Each of the 2,062 rows `[atLeast, butLessThan)` of
`UsTax/TaxRates/TaxTableData.lean` (generated by
`scripts/gen_lean_tax_table.py`) is checked at its lowest dollar `atLeast` and
at its highest cent `butLessThan - $0.01`, for the four printed columns:
16,496 checks. The married filing jointly column stands for qualifying
surviving spouse too; `scheduleFor` maps both to the same table (`rfl` in
`UsTax/TaxRates.lean`).

The checks are `#guard`s: the build fails if any check fails. They run in the
compiled evaluator, not the kernel.
-/

namespace UsTax.TaxRates.TaxTable

/-- The (taxable income, filing status, printed tax) checks of one row, in cents. -/
def checksOf (r : Row) : List (Int × FilingStatus × Int) :=
  [usd r.atLeast, usd r.butLessThan - 1].flatMap fun x =>
    [(x, .single, usd r.single), (x, .marriedFilingJointly, usd r.mfj),
      (x, .marriedFilingSeparately, usd r.mfs), (x, .headOfHousehold, usd r.hoh)]

/-- Every check of the table. -/
def checks : List (Int × FilingStatus × Int) := rows.flatMap checksOf

/-- The checks where the Lean line 16 differs from the printed table. -/
def failures : List (Int × FilingStatus × Int) :=
  checks.filter fun (x, fs, expected) => tentativeTaxFor x fs != expected

#guard rows.length = 2062
#guard checks.length = 16496
#guard failures.isEmpty

end UsTax.TaxRates.TaxTable
