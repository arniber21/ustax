{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ustax.invalid/api/provenance.schema.json",
  "title": "ustax provenance index (api/provenance.json)",
  "description": "For each API line item, the trail from the number to the law. Generated by scripts/gen_provenance.mjs; see docs/provenance.md. `rule` is Catala (a specification validated by tests, NOT a proof), `proofs` are Lean theorems (machine-checked), `tests` are differential tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tax_year", "generator", "sources_index", "field_meanings", "coverage", "lines", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "tax_year": { "const": 2024 },
    "generator": { "type": "string" },
    "sources_index": { "type": "string" },
    "field_meanings": { "type": "object", "required": ["rule", "proofs", "tests", "citations"], "additionalProperties": { "type": "string" } },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_items", "with_catala_rule", "with_legal_citation_found_in_catala", "without_legal_citation_found_in_catala",
        "with_legal_citation_any_origin", "with_direct_file_fact", "direct_file_fact_matches_line_catalog", "with_lean_theorem",
        "without_lean_theorem", "with_difftest", "without_difftest"],
      "properties": {
        "line_items": { "type": "integer" },
        "with_catala_rule": { "type": "integer" },
        "with_legal_citation_found_in_catala": { "type": "integer" },
        "without_legal_citation_found_in_catala": { "$ref": "#/$defs/Keys" },
        "with_legal_citation_any_origin": { "type": "integer" },
        "with_direct_file_fact": { "type": "integer" },
        "direct_file_fact_matches_line_catalog": { "type": "integer" },
        "with_lean_theorem": { "type": "integer" },
        "without_lean_theorem": { "$ref": "#/$defs/Keys" },
        "with_difftest": { "type": "integer" },
        "without_difftest": { "$ref": "#/$defs/Keys" }
      }
    },
    "lines": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/Line" } },
    "files": { "type": "array", "items": { "$ref": "#/$defs/File" } }
  },
  "$defs": {
    "Keys": { "type": "array", "items": { "type": "string" } },
    "Range": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 } }
    },
    "Heading": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["title", "start", "end"],
      "properties": { "title": { "type": "string" }, "level": { "type": "integer" }, "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 } }
    },
    "Loc": {
      "type": "object", "additionalProperties": false, "required": ["file", "line"],
      "properties": { "file": { "type": "string" }, "line": { "type": "integer", "minimum": 1 } }
    },
    "File": {
      "type": "object", "additionalProperties": false, "required": ["path", "kind", "sha256", "lines"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "enum": ["catala", "catala_test", "lean"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lines": { "type": "integer", "minimum": 1 }
      }
    },
    "Citation": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "label", "url", "local", "origin", "found_in"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["statute", "regulation", "revenue_procedure", "notice", "irs_form", "irs_instructions", "irs_publication"] },
        "label": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "local": {
          "type": ["object", "null"], "additionalProperties": false, "required": ["path"],
          "properties": { "path": { "type": "string" }, "page": { "type": "integer" }, "page_end": { "type": "integer" } }
        },
        "origin": { "enum": ["catala", "curated"] },
        "found_in": { "type": "array", "items": { "$ref": "#/$defs/Loc" } }
      }
    },
    "Theorem": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "qualified", "file", "start", "end", "kind", "in_comparator_set", "statement", "covers"],
      "properties": {
        "name": { "type": "string" }, "qualified": { "type": "string" }, "file": { "type": "string" },
        "start": { "type": "integer" }, "end": { "type": "integer" },
        "kind": { "enum": ["main", "lemma"] },
        "in_comparator_set": { "type": "boolean" },
        "statement": { "type": "string" }, "covers": { "type": "string" }
      }
    },
    "Line": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "form", "description", "direct_file_fact", "rule", "citations", "proofs", "lean", "tests"],
      "properties": {
        "key": { "type": "string" },
        "form": {
          "type": "object", "additionalProperties": false, "required": ["form", "line", "label", "pdf"],
          "properties": {
            "form": { "type": "string" }, "line": { "type": "string" }, "label": { "type": "string" },
            "pdf": { "type": "object", "additionalProperties": false, "required": ["path", "page", "url"],
              "properties": { "path": { "type": "string" }, "page": { "type": "integer" }, "url": { "type": "string" } } }
          }
        },
        "description": { "type": "string", "minLength": 1 },
        "direct_file_fact": {
          "type": "object", "additionalProperties": false, "required": ["path", "source", "matches_line_catalog", "line_catalog_path"],
          "properties": {
            "path": { "type": ["string", "null"] },
            "source": { "oneOf": [{ "$ref": "#/$defs/Loc" }, { "type": "null" }] },
            "matches_line_catalog": { "type": "boolean" },
            "line_catalog_path": { "type": ["string", "null"] }
          }
        },
        "rule": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "status", "file", "scope", "variable", "definition", "heading", "statute_heading", "depends_on", "feeds", "quirks"],
          "properties": {
            "kind": { "const": "catala" },
            "status": { "type": "string" },
            "file": { "type": "string" }, "scope": { "type": "string" }, "variable": { "type": "string" },
            "definition": {
              "type": "object", "additionalProperties": false, "required": ["start", "end", "comment_start"],
              "properties": { "start": { "type": "integer", "minimum": 1 }, "end": { "type": "integer", "minimum": 1 }, "comment_start": { "type": "integer", "minimum": 1 } }
            },
            "heading": { "$ref": "#/$defs/Heading" },
            "statute_heading": { "$ref": "#/$defs/Heading" },
            "depends_on": {
              "type": "object", "additionalProperties": false, "required": ["lines", "slots"],
              "properties": {
                "lines": { "type": "array", "items": { "type": "object", "required": ["variable", "api_key"], "properties": { "variable": { "type": "string" }, "api_key": { "type": ["string", "null"] } } } },
                "slots": { "type": "array", "items": { "type": "object", "required": ["slot", "filled_by"], "properties": { "slot": { "type": "string" }, "filled_by": { "type": ["string", "null"] } } } }
              }
            },
            "feeds": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["instance", "file", "scope", "variable", "definition", "heading", "statute_heading"],
                "properties": {
                  "instance": { "type": "string" }, "file": { "type": "string" }, "scope": { "type": "string" }, "variable": { "type": "string" },
                  "definition": { "oneOf": [{ "$ref": "#/$defs/Range" }, { "type": "null" }] },
                  "heading": { "$ref": "#/$defs/Heading" }, "statute_heading": { "$ref": "#/$defs/Heading" }
                }
              }
            },
            "quirks": { "type": "array", "items": { "type": "object", "required": ["id", "line"], "properties": { "id": { "type": "string" }, "line": { "type": "integer" } } } }
          }
        },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/Citation" } },
        "proofs": {
          "type": "object", "additionalProperties": false, "required": ["kind", "status", "theorems"],
          "properties": { "kind": { "const": "lean_theorems" }, "status": { "type": "string" }, "theorems": { "type": "array", "items": { "$ref": "#/$defs/Theorem" } } }
        },
        "lean": {
          "type": "object", "additionalProperties": false, "required": ["kind", "file", "module", "definition", "field", "binding", "field_line", "feeds"],
          "properties": {
            "kind": { "const": "lean_implementation" },
            "file": { "type": "string" }, "module": { "type": "string" }, "definition": { "type": "string" }, "field": { "type": "string" },
            "binding": { "type": "object", "required": ["form", "start", "end"], "properties": { "form": { "enum": ["let", "field"] }, "start": { "type": "integer" }, "end": { "type": "integer" } } },
            "field_line": { "type": ["integer", "null"] },
            "feeds": { "type": "array", "items": { "type": "object", "required": ["instance", "file", "definition", "start", "end"],
              "properties": { "instance": { "type": "string" }, "file": { "type": "string" }, "definition": { "type": "string" }, "start": { "type": "integer" }, "end": { "type": "integer" } } } }
          }
        },
        "tests": {
          "type": "object", "additionalProperties": false, "required": ["kind", "status", "difftest", "catala_unit_tests"],
          "properties": {
            "kind": { "const": "differential_tests" }, "status": { "type": "string" },
            "difftest": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["mapping", "mapping_file", "catala_scope", "catala_file", "role", "report_only"],
                "properties": {
                  "mapping": { "type": "string" }, "mapping_file": { "type": "string" }, "catala_scope": { "type": "string" }, "catala_file": { "type": "string" },
                  "role": { "enum": ["whole_return", "module"] }, "report_only": { "type": "boolean" }
                }
              }
            },
            "catala_unit_tests": { "type": "array", "items": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string" } } } }
          }
        }
      }
    }
  }
}
