declaration scope KnockoutsIncome:
  # ---- Inputs used by several modules
  input filing_status content Types.FilingStatus
  input agi content money
  input primary_filer_can_be_claimed condition
  input secondary_filer_can_be_claimed condition
  # DF: /paidEstimatedTaxesOrFromLastYear
  input paid_estimated_taxes_or_from_last_year condition
  # DF: taxCalculations.xml /knockoutHasNoPaymentsOrCredits, computed by Form1040
  input knockout_has_no_payments_or_credits condition

  # ---- income.xml
  # DF: /incomeSourcesSupported (a Writable Boolean; the questionnaire answer)
  input income_sources_supported condition
  # DF: /receivedDigitalAssets, /disposedDigitalAssets
  input received_digital_assets condition
  input disposed_digital_assets condition
  # DF: /hasForeignAccounts, /isForeignTrustsGrantor, /hasForeignTrustsTransactions
  input has_foreign_accounts condition
  input is_foreign_trusts_grantor condition
  input has_foreign_trusts_transactions condition
  # DF: /madeIraContributions
  input made_ira_contributions condition

  # ---- Interest
  input interest_reports content list of I.InterestReport

  # ---- W-2
  input w2s content list of W.FormW2
  input combat_pay_election content W.CombatPayElection
  # The state facts of formW2s.xml. The W-2 boxes 14 and 15 behind them are not
  # modelled (state-return data, catala/form_w2s.catala_en header), so the
  # derived DF conditions are inputs.
  # DF: /flowKnockoutBox15IncomeFromDifferentState
  input w2_box15_income_from_different_state condition
  # DF: /hasABox14NYRRTAValueWeKnockout
  input w2_has_box14_nyrrta_knockout_code condition
  # DF: count of /formW2s/*/hasRRTACodesInBox14 > 0
  input w2_has_rrta_codes_in_box14 condition
  # DF: filers.xml /livedInNy
  input lived_in_ny condition
  # DF: count of /formW2s/*/paidYonkersTaxes > 0, and /partYearYonkersResident
  input w2_paid_yonkers_taxes condition
  input part_year_yonkers_resident condition

  # ---- State scoping (filers.xml /flowKnockoutUnsupportedState)
  # DF: /filerResidenceAndIncomeState
  input filer_residence_and_income_state content Types.ScopedState
  # DF: /primaryFilerW2And1099IntInScopedState = anotherState (the enum of
  # `/primaryFilerW2And1099IntStateOptions` is reduced to this test)
  input primary_filer_forms_another_state condition
  # DF: /receivedAlaskaPfd, /spouseReceivedAlaskaPfd
  input received_alaska_pfd condition
  input spouse_received_alaska_pfd condition
  # DF: filingStatus.xml /treatAsMFJ
  input treat_as_mfj condition
  # DF: /spouseLivesInTPState is moreThanOne or noneOfTheAbove
  input spouse_lives_in_other_or_multiple_states condition
  # DF: /allSpouseFormsInScopedState = anotherState
  input spouse_forms_another_state condition

  # ---- 1099-G, 1099-MISC, 1099-R
  input form_1099gs content list of U.Form1099G
  input form_1099miscs content list of M.Form1099Misc
  input form_1099rs content list of RS.Form1099R

  # ---- Social Security (only the repayment knockout is read; the other inputs
  # are the line values SocialSecurity requires, supplied by Form1040)
  input report_net_benefits content list of money
  input lived_apart_all_year condition
  input line_1z content money
  input line_2a content money
  input line_2b content money
  input line_3b content money
  input line_4b content money
  input line_5b content money
  input line_7_capital_gains content money
  input line_8_other_income content money
  input adjustments_excluding_student_loan_interest content money

  # ---- Estimated payments
  input estimated_tax_payment_writable content money
  input paid_estimated_taxes_or_from_last_year_under_different_name condition
  input paid_estimated_taxes_with_former_spouse content E.PaidWithFormerSpouse

  # ---- HSA (inputs of Hsa, see catala/hsa.catala_en "Wiring")
  input is_filing_status_mfj condition
  input is_married condition
  input is_single condition
  input primary_filer_age55_or_older condition
  input secondary_filer_age55_or_older condition
  input primary_filer_total_hsa_contributions_from_w2s content money
  input secondary_filer_total_hsa_contributions_from_w2s content money
  input has_primary_filer_hsa_contributions_from_w2s condition
  input has_secondary_filer_hsa_contributions_from_w2s condition
  input tax_exempt_interest content money
  input pensions_and_annuities content money
  input social_security_benefits content money
  input hsa_primary_filer content H.HsaFilerAnswers
  input hsa_secondary_filer content H.HsaFilerAnswers
  input some_filer_had_non_w2_hsa_activity content boolean
  input writable_primary_filer_had_non_w2_hsa_activity content boolean
  input writable_secondary_filer_had_non_w2_hsa_activity content boolean
  input has_hsa_medical_savings_account_type content boolean
  input writable_has_hsa_excess_contributions_previous_year content boolean
  input writable_has_hsa_withdrawn_excess_contributions_yes_no content boolean
  input some_filers_made_testing_period_contribution content boolean
  input some_filers_have_testing_period_additional_income content boolean
  input hsa_distributions content list of H.HsaDistribution

  # ---- process
  # DF: flow.xml /isAfterTaxDayAndNotResubmitting and /isAfterResubmissionDeadline.
  # In DF both are the constant False ("needs to be re-evaluated", issue 8045); here they are
  # inputs so the server can set them from the clock.
  input is_after_tax_day_and_not_resubmitting condition
  input is_after_resubmission_deadline condition

  # ---- Sub-scopes
  interest scope I.Interest
  w2 scope W.FormW2s
  unemp scope U.Unemployment
  misc scope M.Form1099Miscs
  rs scope RS.Form1099Rs
  ss scope S.SocialSecurity
  ep scope E.EstimatedPayments
  hsa scope H.Hsa

  # ---- Outputs
  # DF: income.xml /hasForeignAccountsOrTrusts
  internal has_foreign_accounts_or_trusts condition
  # DF: filers.xml /hasIncomeInScope
  internal has_income_in_scope condition

  output interest_knockouts content InterestKnockouts
  output form_w2_knockouts content FormW2Knockouts
  output unemployment_knockouts content UnemploymentKnockouts
  output form1099_misc_knockouts content Form1099MiscKnockouts
  output form1099_r_knockouts content Form1099RKnockouts
  output social_security_knockouts content SocialSecurityKnockouts
  output estimated_payments_knockouts content EstimatedPaymentsKnockouts
  output hsa_knockouts content HsaKnockouts
  output local_knockouts content LocalKnockouts
  # One flag per module: the module's own `unsupported`

  output unsupported_interest condition
  output unsupported_w2s condition
  output unsupported_unemployment condition
  output unsupported_misc condition
  output unsupported_rs condition
  output unsupported_ss condition
  output unsupported_ep condition
  output unsupported_hsa condition
  # The knockouts defined here: income.xml, formW2s.xml state facts, process
  output unsupported_local condition
  # Any income, HSA or process knockout
  output unsupported_income_or_hsa condition
  # The reasons that fired, in the order of KnockoutReason
  internal knockout_table content list of KnockoutEntry
  output fired_knockouts content list of KnockoutReason
```

## Wiring of the sub-scopes

```catala
scope KnockoutsIncome:
  # DF: income.xml /hasForeignAccountsOrTrusts
  definition has_foreign_accounts_or_trusts equals
    has_foreign_accounts or is_foreign_trusts_grantor or has_foreign_trusts_transactions

  # DF: filers.xml /hasIncomeInScope. The filer earned income in exactly one
  # in-scope state, no income form is from another state, and an Alaska PFD is
  # received only by an Alaska resident. For a joint return the same tests are
  # made for the spouse.
  definition has_income_in_scope equals not (
    filer_residence_and_income_state = Types.ScopedState.NoneOfThese
    or filer_residence_and_income_state = Types.ScopedState.MoreThanOne
    or primary_filer_forms_another_state
    or (received_alaska_pfd
        and filer_residence_and_income_state != Types.ScopedState.AK)
    or (treat_as_mfj and spouse_received_alaska_pfd
        and filer_residence_and_income_state != Types.ScopedState.AK)
    or (treat_as_mfj and spouse_lives_in_other_or_multiple_states)
    or (treat_as_mfj and spouse_forms_another_state))

  # Interest. flow_has_seen_deductions is true, as for Form1040.interest_ko
  # (catala/form_1040.catala_en): the AGI knockouts are evaluated.
  definition interest.interest_reports equals interest_reports
  definition interest.has_foreign_accounts_or_trusts equals has_foreign_accounts_or_trusts
  definition interest.filing_status equals filing_status
  definition interest.agi equals agi
  definition interest.flow_has_seen_deductions equals true

  definition w2.w2s equals w2s
  definition w2.filing_status equals filing_status
  definition w2.primary_filer_can_be_claimed equals primary_filer_can_be_claimed
  definition w2.secondary_filer_can_be_claimed equals secondary_filer_can_be_claimed
  definition w2.combat_pay_election equals combat_pay_election

  definition unemp.form_1099gs equals form_1099gs
  definition misc.form_1099miscs equals form_1099miscs
  definition rs.forms equals form_1099rs

  definition ss.report_net_benefits equals report_net_benefits
  definition ss.filing_status equals filing_status
  definition ss.lived_apart_all_year equals lived_apart_all_year
  definition ss.line_1z equals line_1z
  definition ss.line_2a equals line_2a
  definition ss.line_2b equals line_2b
  definition ss.line_3b equals line_3b
  definition ss.line_4b equals line_4b
  definition ss.line_5b equals line_5b
  definition ss.line_7_capital_gains equals line_7_capital_gains
  definition ss.line_8_other_income equals line_8_other_income
  definition ss.adjustments_excluding_student_loan_interest equals
    adjustments_excluding_student_loan_interest

  definition ep.paid_estimated_taxes_or_from_last_year equals
    paid_estimated_taxes_or_from_last_year
  definition ep.estimated_tax_payment_writable equals estimated_tax_payment_writable
  definition ep.paid_estimated_taxes_with_former_spouse equals paid_estimated_taxes_with_former_spouse
  definition ep.paid_estimated_taxes_or_from_last_year_under_different_name equals
    paid_estimated_taxes_or_from_last_year_under_different_name

  definition hsa.is_filing_status_mfj equals is_filing_status_mfj
  definition hsa.is_married equals is_married
  definition hsa.is_single equals is_single
  definition hsa.primary_filer_age55_or_older equals primary_filer_age55_or_older
  definition hsa.secondary_filer_age55_or_older equals secondary_filer_age55_or_older
  definition hsa.primary_filer_can_be_claimed equals primary_filer_can_be_claimed
  definition hsa.secondary_filer_can_be_claimed equals secondary_filer_can_be_claimed
  definition hsa.primary_filer_total_hsa_contributions_from_w2s equals
    primary_filer_total_hsa_contributions_from_w2s
  definition hsa.secondary_filer_total_hsa_contributions_from_w2s equals
    secondary_filer_total_hsa_contributions_from_w2s
  definition hsa.has_primary_filer_hsa_contributions_from_w2s equals
    has_primary_filer_hsa_contributions_from_w2s
  definition hsa.has_secondary_filer_hsa_contributions_from_w2s equals
    has_secondary_filer_hsa_contributions_from_w2s
  definition hsa.knockout_has_no_payments_or_credits equals knockout_has_no_payments_or_credits
  definition hsa.paid_estimated_taxes_or_from_last_year equals paid_estimated_taxes_or_from_last_year
  definition hsa.tax_exempt_interest equals tax_exempt_interest
  definition hsa.pensions_and_annuities equals pensions_and_annuities
  definition hsa.social_security_benefits equals social_security_benefits
  definition hsa.primary_filer equals hsa_primary_filer
  definition hsa.secondary_filer equals hsa_secondary_filer
  definition hsa.some_filer_had_non_w2_hsa_activity equals some_filer_had_non_w2_hsa_activity
  definition hsa.writable_primary_filer_had_non_w2_hsa_activity equals
    writable_primary_filer_had_non_w2_hsa_activity
  definition hsa.writable_secondary_filer_had_non_w2_hsa_activity equals
    writable_secondary_filer_had_non_w2_hsa_activity
  definition hsa.has_hsa_medical_savings_account_type equals has_hsa_medical_savings_account_type
  definition hsa.writable_has_hsa_excess_contributions_previous_year equals
    writable_has_hsa_excess_contributions_previous_year
  definition hsa.writable_has_hsa_withdrawn_excess_contributions_yes_no equals
    writable_has_hsa_withdrawn_excess_contributions_yes_no
  definition hsa.some_filers_made_testing_period_contribution equals
    some_filers_made_testing_period_contribution
  definition hsa.some_filers_have_testing_period_additional_income equals
    some_filers_have_testing_period_additional_income
  definition hsa.hsa_distributions equals hsa_distributions
```

## Knockouts of the merged modules, one structure per module

```catala
scope KnockoutsIncome:
  definition interest_knockouts equals InterestKnockouts {
    -- ko_has_required_facta_filings: interest.ko_has_required_facta_filings
    -- ko_flow_knockout_has_early_withdrawl_penalty: interest.ko_flow_knockout_has_early_withdrawl_penalty
    -- ko_flow_knockout_has_bonds: interest.ko_flow_knockout_has_bonds
    -- ko_flow_knockout_has_foreign_tax_paid: interest.ko_flow_knockout_has_foreign_tax_paid
    -- ko_flow_knockout_withholding_unsupported_state: interest.ko_flow_knockout_withholding_unsupported_state
    -- ko_flow_knockout_state_tax_withheld: interest.ko_flow_knockout_state_tax_withheld
    -- ko_has_interest_income_and_agi_above_threshold_for_mfs: interest.ko_has_interest_income_and_agi_above_threshold_for_mfs
    -- ko_has_interest_income_and_agi_above_threshold_for_mfj_or_qss: interest.ko_has_interest_income_and_agi_above_threshold_for_mfj_or_qss
    -- ko_has_interest_income_and_agi_above_threshold_for_single_or_hoh: interest.ko_has_interest_income_and_agi_above_threshold_for_single_or_hoh
    -- ko_flow_knockout_tax_exempt_interest: interest.ko_flow_knockout_tax_exempt_interest
  }
  definition form_w2_knockouts equals FormW2Knockouts {
    -- ko_knockout_for_box12_value: w2.ko_knockout_for_box12_value
    -- ko_knockout_for_box12_dependency: w2.ko_knockout_for_box12_dependency
    -- ko_flow_knockout_allocated_tips: w2.ko_flow_knockout_allocated_tips
    -- ko_flow_knockout_statutory_employee: w2.ko_flow_knockout_statutory_employee
    -- ko_flow_knockout_third_party_sick_pay: w2.ko_flow_knockout_third_party_sick_pay
