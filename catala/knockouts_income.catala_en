    -- ko_knockout_for_form1099_r_box8_value: rs.ko_knockout_for_form1099_r_box8_value
    -- ko_knockout_for_form1099_r_box8_percentage: rs.ko_knockout_for_form1099_r_box8_percentage
    -- ko_knockout_for_form1099_r_box9a_percentage: rs.ko_knockout_for_form1099_r_box9a_percentage
    -- ko_flow_knockout_retirement_capital_gain: rs.ko_flow_knockout_retirement_capital_gain
    -- ko_flow_knockout_retirement_net_unrealized_appreciation: rs.ko_flow_knockout_retirement_net_unrealized_appreciation
    -- ko_flow_knockout_retirement_amount_allocable_to_irr: rs.ko_flow_knockout_retirement_amount_allocable_to_irr
    -- ko_flow_knockout_retirement_facta_filing_requirement: rs.ko_flow_knockout_retirement_facta_filing_requirement
    -- ko_flow_knockout_for_rollover: rs.ko_flow_knockout_for_rollover
    -- ko_flow_knockout_for_death_benefit_payment_date: rs.ko_flow_knockout_for_death_benefit_payment_date
    -- ko_flow_knockout_retirement_qualified_disaster_distribution: rs.ko_flow_knockout_retirement_qualified_disaster_distribution
    -- ko_flow_knockout_retirement_public_safety_officer: rs.ko_flow_knockout_retirement_public_safety_officer
    -- ko_flow_knockout_for_pre_tax_to_post_tax_rollover: rs.ko_flow_knockout_for_pre_tax_to_post_tax_rollover
    -- ko_flow_knockout_box15: rs.ko_flow_knockout_box15
    -- ko_knockout_for_form1099_r_distribution_code: rs.ko_knockout_for_form1099_r_distribution_code
    -- ko_knockout_ira_sep_simple: rs.ko_knockout_ira_sep_simple
    -- ko_knockout_taxable_pension_rollover: rs.ko_knockout_taxable_pension_rollover
    -- ko_knockout_indirect_rollover: rs.ko_knockout_indirect_rollover
    -- ko_knockout_taxable_amount_not_determined: rs.ko_knockout_taxable_amount_not_determined
  }
  definition social_security_knockouts equals SocialSecurityKnockouts {
    -- ko_social_security_repayment_over_3k: ss.repayment_over_3k
  }
  definition estimated_payments_knockouts equals EstimatedPaymentsKnockouts {
    -- ko_knockout_paid_estimated_taxes_under_different_last_name: ep.ko_knockout_paid_estimated_taxes_under_different_last_name
