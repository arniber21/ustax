declaration scope Compute:
  d scope Data
  output results content list of Result

scope Compute:
  definition results equals
    map each r among d.rows to
      (let o equals
         output of F.PtcFamily with {
           -- filing_status: Types.FilingStatus.Single
           -- claimed_dependents_count: 0
           -- primary_someone_can_claim_for_tax_benefits: false
           -- secondary_someone_can_claim_for_tax_benefits: false
           -- lived_in_ak: false
           -- lived_in_hi: false
           -- agi: r.income
           -- tax_exempt_interest: $0
           -- non_taxable_social_security_benefits: $0
         } in
       Result { -- row: r
                -- percent: o.household_income_as_percent
                -- figure: o.applicable_figure })

#[test]
declaration scope TestTable2:
  c scope Compute

scope TestTable2:
  assertion number of (list of x among c.results such that
    x.percent != x.row.percent) = 0
  assertion number of (list of x among c.results such that
    x.figure != x.row.figure) = 0
  assertion number of c.results = 255
