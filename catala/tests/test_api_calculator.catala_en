    -- filing_answers: Api.ApiFilingAnswers {
         -- marital_status: Api.ApiMaritalStatus.Unspecified
         -- year_of_spouse_death: Api.ApiYearOfSpouseDeath.Unspecified
         -- secondary_filer_date_of_death: |2024-12-31|
         -- primary_filer_potential_claimer_filed_only_for_refund: false
         -- mfj_required_to_file: false
         -- mfj_dependents_filing_for_credits: false
         -- lived_together_all_year_with_spouse: true
         -- spouse_lived_together_months: F.SpouseLivedTogetherMonths.LivedApartAllYear
         -- lived_apart_last_six_months: false
