    -- adjustments: Api.ApiAdjustments {
         -- educator_expenses: Api.ApiEducator {
              -- was_k12_educators: EA.K12EducatorOptions.Neither
              -- primary_expenses: $0
              -- secondary_expenses: $0 }
         -- student_loan_interest: Api.ApiStudentLoan {
              -- had_payments: false -- loans_qualify: false -- interest_amount: $0 }
         -- hsa: Calc.HsaInput {
