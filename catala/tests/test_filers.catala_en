# Tests for the Filers module

Run with `clerk test`. Cases are worked by hand from the statute and the IRS
publications cited in `catala/filers.catala_en`; the oracle comparison against
Direct File is `make difftest SCOPE=filers`.

> Using Types
> Using Filers as F

## A baseline return that each test changes in a few places

`Case` is one complete, satisfiable set of inputs: a single filer born
1985-06-15, a US citizen, not claimed by anyone, living in Florida, with a
second filer entry that carries plain citizen answers. Every input is a
`context` variable with a default, so a test overrides only what it tests.
`Case` feeds the same inputs to `Filers` and to `FilersStandardDeduction`.

```catala
declaration scope Case:
  context filing_status content Types.FilingStatus
  context marital_status content F.MaritalStatus
  context year_of_spouse_death content F.YearOfSpouseDeath
  context primary_dob content date
  context secondary_dob content date
  context secondary_date_of_death content date
  context primary_blind content boolean
  context secondary_blind content boolean
  context primary_can_be_claimed content boolean
  context primary_will_be_claimed content boolean
  context primary_claimer_must_file content boolean
  context primary_claimer_did_file content boolean
  context secondary_can_be_claimed content boolean
  context secondary_will_be_claimed content boolean
  context primary_is_citizen content boolean
  context secondary_is_citizen content boolean
  context claimer_filed_only_for_refund condition
  context mfj_required_to_file condition
  context mfj_dependents_filing_for_credits condition
  context lived_together_all_year condition
  context lived_together_months content F.SpouseLivedTogetherMonths
  context lived_apart_last_six_months condition
  context separation_agreement condition
  context can_file_jointly_year_of_spouse_death condition
  context in_registered_domestic_partnership condition
  context residence_state content Types.ScopedState
  context spouse_itemizes condition
  context mfs_living_spouse_filing_return condition
  context mfs_deceased_spouse_filing_return condition
  context mfs_spouse_has_gross_income condition
  context eligible_for_hoh condition
  context mfs_spouse_65_or_older condition
  context employer_income_subtotal content money

  internal primary_answers content F.FilerAnswers
  internal secondary_answers content F.FilerAnswers
  filers scope F.Filers
  fsd scope F.FilersStandardDeduction

  output primary_age content integer
  output primary_age65 condition
  output secondary_age65 condition
  output primary_age25_for_eitc condition
  output primary_age64_for_eitc condition
  output secondary_age25_for_eitc condition
  output secondary_age64_for_eitc condition
  output deceased_spouse_reached_age65 condition
  output treat_filers_as_dependents condition
  output is_mfj_dependent condition
  output taxpayer_cannot_be_claimed condition
  output treat_as_mfj condition
  output eligible_for_mfj condition
  output lived_apart_last_six condition
  output special_rule_for_separated_spouses condition
  output filer_could_qualify_for_hoh condition
  output minimum_filer_date_of_birth content date
  output unsupported condition
  output ko_under16 condition
  output ko_community_property condition
  output ko_domestic_partner condition
  output ko_residency condition
  output ko_spouse_itemizes condition
  output standard_deduction content money

scope Case:
  definition filing_status equals Single
  definition marital_status equals NeverMarried
  definition year_of_spouse_death equals DiedBeforeTaxYearMinusTwo
  definition primary_dob equals |1985-06-15|
  definition secondary_dob equals |1985-06-15|
  definition secondary_date_of_death equals |2024-12-31|
  definition primary_blind equals false
  definition secondary_blind equals false
  definition primary_can_be_claimed equals false
  definition primary_will_be_claimed equals false
  definition primary_claimer_must_file equals false
  definition primary_claimer_did_file equals false
  definition secondary_can_be_claimed equals false
  definition secondary_will_be_claimed equals false
  definition primary_is_citizen equals true
  definition secondary_is_citizen equals true
  definition claimer_filed_only_for_refund equals false
  definition mfj_required_to_file equals true
  definition mfj_dependents_filing_for_credits equals false
  definition lived_together_all_year equals true
  definition lived_together_months equals LivedApartAllYear
  definition lived_apart_last_six_months equals false
  definition separation_agreement equals false
  definition can_file_jointly_year_of_spouse_death equals false
  definition in_registered_domestic_partnership equals false
  definition residence_state equals FL
  definition spouse_itemizes equals false
  definition mfs_living_spouse_filing_return equals false
  definition mfs_deceased_spouse_filing_return equals false
  definition mfs_spouse_has_gross_income equals false
  definition eligible_for_hoh equals false
  definition mfs_spouse_65_or_older equals false
  definition employer_income_subtotal equals $50,000

  definition filers.filing_status equals filing_status
  definition filers.marital_status equals marital_status
  definition filers.year_of_spouse_death equals year_of_spouse_death
  definition primary_answers equals
    F.FilerAnswers {
      -- date_of_birth: primary_dob
      -- is_blind: primary_blind
      -- can_be_claimed: primary_can_be_claimed
      -- will_be_claimed: primary_will_be_claimed
      -- potential_claimer_must_file: primary_claimer_must_file
      -- potential_claimer_did_file: primary_claimer_did_file
      -- is_us_citizen_full_year: primary_is_citizen
      -- writable_citizen_at_end_of_tax_year: false
      -- writable_is_noncitizen_resident_full_year: false
      -- writable_is_national: false
    }
  definition secondary_answers equals
    F.FilerAnswers {
      -- date_of_birth: secondary_dob
      -- is_blind: secondary_blind
      -- can_be_claimed: secondary_can_be_claimed
      -- will_be_claimed: secondary_will_be_claimed
      -- potential_claimer_must_file: false
      -- potential_claimer_did_file: false
      -- is_us_citizen_full_year: secondary_is_citizen
      -- writable_citizen_at_end_of_tax_year: false
      -- writable_is_noncitizen_resident_full_year: false
      -- writable_is_national: false
    }
  definition filers.primary_filer equals primary_answers
  definition filers.secondary_filer equals secondary_answers
  definition filers.secondary_filer_date_of_death equals secondary_date_of_death
  definition filers.primary_filer_potential_claimer_filed_only_for_refund equals
    claimer_filed_only_for_refund
  definition filers.mfj_required_to_file equals mfj_required_to_file
  definition filers.mfj_dependents_filing_for_credits equals
    mfj_dependents_filing_for_credits
  definition filers.lived_together_all_year_with_spouse equals lived_together_all_year
  definition filers.spouse_lived_together_months equals lived_together_months
  definition filers.writable_lived_apart_last_six_months equals
    lived_apart_last_six_months
  definition filers.writable_separation_agreement equals separation_agreement
  definition filers.can_file_jointly_year_of_spouse_death equals
    can_file_jointly_year_of_spouse_death
  definition filers.in_registered_domestic_partnership equals
    in_registered_domestic_partnership
  definition filers.filer_residence_and_income_state equals residence_state
  definition filers.spouse_itemizes equals spouse_itemizes
  definition filers.mfs_living_spouse_filing_return equals mfs_living_spouse_filing_return
  definition filers.mfs_deceased_spouse_filing_return equals
    mfs_deceased_spouse_filing_return
  definition filers.mfs_spouse_has_gross_income equals mfs_spouse_has_gross_income
  definition filers.eligible_for_hoh equals eligible_for_hoh

  definition fsd.filing_status equals filing_status
  definition fsd.marital_status equals marital_status
  definition fsd.year_of_spouse_death equals year_of_spouse_death
  definition fsd.primary_filer equals primary_answers
  definition fsd.secondary_filer equals secondary_answers
  definition fsd.secondary_filer_date_of_death equals secondary_date_of_death
  definition fsd.primary_filer_potential_claimer_filed_only_for_refund equals
    claimer_filed_only_for_refund
  definition fsd.mfj_required_to_file equals mfj_required_to_file
  definition fsd.mfj_dependents_filing_for_credits equals
    mfj_dependents_filing_for_credits
  definition fsd.lived_together_all_year_with_spouse equals lived_together_all_year
  definition fsd.spouse_lived_together_months equals lived_together_months
  definition fsd.writable_lived_apart_last_six_months equals
    lived_apart_last_six_months
  definition fsd.writable_separation_agreement equals separation_agreement
  definition fsd.can_file_jointly_year_of_spouse_death equals
    can_file_jointly_year_of_spouse_death
  definition fsd.in_registered_domestic_partnership equals
    in_registered_domestic_partnership
  definition fsd.filer_residence_and_income_state equals residence_state
  definition fsd.spouse_itemizes equals spouse_itemizes
  definition fsd.mfs_living_spouse_filing_return equals mfs_living_spouse_filing_return
  definition fsd.mfs_deceased_spouse_filing_return equals
    mfs_deceased_spouse_filing_return
  definition fsd.mfs_spouse_has_gross_income equals mfs_spouse_has_gross_income
  definition fsd.eligible_for_hoh equals eligible_for_hoh
  definition fsd.mfs_spouse_65_or_older equals mfs_spouse_65_or_older
  definition fsd.employer_income_subtotal equals employer_income_subtotal

  definition primary_age equals filers.primary_filer_age
  definition primary_age65 equals filers.primary_filer_age65_or_older
  definition secondary_age65 equals filers.secondary_filer_age65_or_older
  definition primary_age25_for_eitc equals filers.primary_filer_age25_or_older_for_eitc
  definition primary_age64_for_eitc equals filers.primary_filer_age64_or_younger_for_eitc
  definition secondary_age25_for_eitc equals filers.secondary_filer_age25_or_older_for_eitc
  definition secondary_age64_for_eitc equals filers.secondary_filer_age64_or_younger_for_eitc
  definition deceased_spouse_reached_age65 equals
    filers.mfj_deceased_spouse_reached_age65_for_standard_d
  definition treat_filers_as_dependents equals filers.treat_filers_as_dependents
  definition is_mfj_dependent equals filers.is_mfj_dependent
  definition taxpayer_cannot_be_claimed equals filers.taxpayer_cannot_be_claimed
  definition treat_as_mfj equals filers.treat_as_mfj
