  ]
  definition failures equals
    number of (list of r among rows such that
      not (for all x among [r.lo; r.hi - $1] we have
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: false -- qualifying_children: 0 } in
     x >= t.completed_phaseout or t.amount = r.s0) and
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: false -- qualifying_children: 1 } in
     x >= t.completed_phaseout or t.amount = r.s1) and
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: false -- qualifying_children: 2 } in
     x >= t.completed_phaseout or t.amount = r.s2) and
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: false -- qualifying_children: 3 } in
     x >= t.completed_phaseout or t.amount = r.s3) and
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: true -- qualifying_children: 0 } in
     x >= t.completed_phaseout or t.amount = r.mfj0) and
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: true -- qualifying_children: 1 } in
     x >= t.completed_phaseout or t.amount = r.mfj1) and
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: true -- qualifying_children: 2 } in
     x >= t.completed_phaseout or t.amount = r.mfj2) and
    (let t equals output of E.EitcTable with {
      -- earned_income: x -- agi: x -- is_mfj: true -- qualifying_children: 3 } in
     x >= t.completed_phaseout or t.amount = r.mfj3)))
  rule ok under condition failures = 0 consequence fulfilled
  assertion failures = 0

