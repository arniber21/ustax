  output mar_enrollment_premium content money
  output mar_slcsp_premium content money
  output mar_contribution_amount content money
  output mar_max_premium_assistance content money
  output mar_ptc_allowed content money
  output mar_advance_payment content money
  output apr_has_active_policy content boolean
  output apr_enrollment_premium content money
  output apr_slcsp_premium content money
  output apr_contribution_amount content money
  output apr_max_premium_assistance content money
  output apr_ptc_allowed content money
  output apr_advance_payment content money
