  definition f.filing_status equals Types.FilingStatus.Single
  definition f.agi equals $50,000.00
  definition f.primary_filer_can_be_claimed equals false
  definition f.secondary_filer_can_be_claimed equals false
  definition f.paid_estimated_taxes_or_from_last_year equals c_est_paid
  definition f.knockout_has_no_payments_or_credits equals c_no_payments
  definition f.income_sources_supported equals c_income_sources_supported
