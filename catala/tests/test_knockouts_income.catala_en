  definition f.hsa_distributions equals []
  definition f.is_after_tax_day_and_not_resubmitting equals c_too_late
  definition f.is_after_resubmission_deadline equals false

  definition n_fired equals number of f.fired_knockouts
  definition unsupported equals f.unsupported_income_or_hsa
  definition fired equals f.fired_knockouts
  definition u_interest equals f.unsupported_interest
  definition u_w2s equals f.unsupported_w2s
  definition u_unemployment equals f.unsupported_unemployment
  definition u_misc equals f.unsupported_misc
  definition u_rs equals f.unsupported_rs
  definition u_ss equals f.unsupported_ss
  definition u_ep equals f.unsupported_ep
  definition u_hsa equals f.unsupported_hsa
  definition u_local equals f.unsupported_local
```

## No knockout on a clean return

```catala
#[test]
declaration scope TestCleanReturn:
  c scope Case

scope TestCleanReturn:
  assertion not c.unsupported
  assertion c.n_fired = 0
  assertion not c.u_interest
  assertion not c.u_w2s
  assertion not c.u_unemployment
  assertion not c.u_misc
  assertion not c.u_rs
  assertion not c.u_ss
  assertion not c.u_ep
  assertion not c.u_hsa
  assertion not c.u_local
```

## Interest: box 9 to 13 amounts (market discount) are unsupported.

```catala
#[test]
declaration scope TestInterestBonds:
  c scope Case

scope TestInterestBonds:
  definition c.c_interest equals [ I.InterestReport {
      -- filer: Types.FilerRole.PrimaryFiler
      -- has_1099: true
      -- no_1099_amount: $0
      -- writable_1099_amount: $100.00
      -- writable_early_withdrawl_penalty_amount: $0
      -- writable_interest_on_government_bonds: $0
      -- writable_tax_withheld: $0
      -- writable_foreign_tax_paid: $0
      -- writable_tax_exempt_interest: $0
      -- writable_specified_private_activity_bond_interest: $0
      -- writable_market_discount: $5.00
      -- writable_bond_premium: $0
      -- writable_bond_premium_on_treasury_obligations: $0
      -- writable_bond_premium_on_tax_exempt_bond: $0
      -- state_is_different_state: false
      -- writable_state_tax_withheld: $0
      -- facta_filing_required: false
    } ]
  assertion c.unsupported
  assertion c.u_interest
  assertion c.n_fired = 1
  assertion exists r among c.fired such that r = K.KnockoutReason.FlowKnockoutHasBonds
```

