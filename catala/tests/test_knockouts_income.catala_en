## 1099-G: more than $3,000 repaid of an earlier year (IRC 1341(a)(3)).

```catala
#[test]
declaration scope TestUnemploymentRepayTooHigh:
  c scope Case

scope TestUnemploymentRepayTooHigh:
  definition c.c_gs equals [ U.Form1099G {
      -- filer: Types.FilerRole.PrimaryFiler
      -- amount: $5,000.00
      -- writable_amount_paid_back_for_benefits_in_tax_year: $0
      -- writable_amount_paid_back_for_benefits_before_tax_year: $3,001.00
      -- writable_federal_tax_withheld: $0
      -- state_is_different_state: false
    } ]
  assertion c.unsupported
  assertion c.u_unemployment
  assertion c.n_fired = 1
  assertion exists r among c.fired such that r = K.KnockoutReason.FlowKnockout1099GRepayTooHigh
```

