## 1099-R: FATCA filing requirement.

```catala
#[test]
declaration scope Test1099RFactaFiling:
  c scope Case

scope Test1099RFactaFiling:
  definition c.c_rs equals [ RS.Form1099R {
      -- filer: Types.FilerRole.PrimaryFiler
      -- distribution_code: [RS.CodeChar.Code7]
      -- writable_gross_distribution: $0
      -- writable_taxable_amount: $0
      -- taxable_amount_blank: false
      -- taxable_amount_not_determined: false
      -- total_distribution: false
      -- writable_capital_gain: $0
      -- writable_federal_withholding: $0
      -- writable_net_appreciation: $0
      -- ira_sep_simple: false
      -- writable_other_dollar: $0
      -- other_percentage_nonzero: false
      -- percentage_total_distribution_nonzero: false
      -- writable_amount_allocable_to_irr: $0
      -- facta_filing_requirement: true
      -- writable_state_tax_withheld: $0
      -- payer_state_is_different: false
      -- has_death_benefit_payment_date: false
      -- writable_is_indirect_rollover: false
      -- writable_is_distribution_from_military_retirement_plan: false
      -- writable_qualified_disaster_distribution: false
      -- writeable_public_safety_officer: false
      -- writeable_public_safety_officer_premiums: false
      -- recipient_date_of_birth: |1990-06-15|
    } ]
  assertion c.unsupported
  assertion c.u_rs
  assertion c.n_fired = 1
  assertion exists r among c.fired such that r = K.KnockoutReason.FlowKnockoutRetirementFactaFilingRequirement
```

## Social Security: net benefits below minus $3,000 (lump-sum repayment).

```catala
#[test]
declaration scope TestSocialSecurityRepayment:
  c scope Case

scope TestSocialSecurityRepayment:
  definition c.c_ss equals [ - $4,000.00 ]
  assertion c.unsupported
  assertion c.u_ss
  assertion c.n_fired = 1
  assertion exists r among c.fired such that r = K.KnockoutReason.SocialSecurityBenefitsAreLossGreaterThan3k
```

