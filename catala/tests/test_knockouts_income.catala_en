  definition f.form_1099gs equals c_gs
  definition f.form_1099miscs equals c_miscs
  definition f.form_1099rs equals c_rs
  definition f.report_net_benefits equals c_ss
  definition f.lived_apart_all_year equals false
  definition f.line_1z equals $0
  definition f.line_2a equals $0
  definition f.line_2b equals $0
  definition f.line_3b equals $0
  definition f.line_4b equals $0
  definition f.line_5b equals $0
  definition f.line_7_capital_gains equals $0
  definition f.line_8_other_income equals $0
  definition f.adjustments_excluding_student_loan_interest equals $0
  definition f.estimated_tax_payment_writable equals $0
  definition f.paid_estimated_taxes_or_from_last_year_under_different_name equals c_est_diff
  definition f.paid_estimated_taxes_with_former_spouse equals E.PaidWithFormerSpouse.Neither
  definition f.is_filing_status_mfj equals false
