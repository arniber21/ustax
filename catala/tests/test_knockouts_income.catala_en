    -- writable_marital_change_affect_contribution_limit_bool: false
    -- has_made_qualified_hsa_funding_distribution: false
    -- writable_hsa_nonemployer_contributions_tax_year: $0
    -- writable_hsa_nonemployer_contributions_tax_year_plus_one: $0
  }
  definition f.hsa_secondary_filer equals H.HsaFilerAnswers {
    -- writable_primary_filer_has_made_contributions_to_hsa: false
