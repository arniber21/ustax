## The request, and the response

```catala-metadata
## The API request (`CalculateRequest`) after decoding. `api_version` and
## `tax_year` are checked by the server and carry no tax fact.
declaration structure ApiRequest:
  data filing_status content Types.FilingStatus
  data filers content ApiFilers
  data filing_details content ApiFilingDetails
  data filing_answers content ApiFilingAnswers
  data dependents content list of ApiDependent
  data w2s content list of ApiW2
  data interest_reports content list of ApiInterest
  data form_1099g content list of ApiForm1099G
  data form_1099misc content list of ApiForm1099Misc
  data form_1099r content list of ApiForm1099R
  data social_security content ApiSocialSecurity
  data adjustments content ApiAdjustments
  data estimated_payments content ApiEstimatedPayments
  data credits content Calc.CreditAnswers
  data cdcc content Calc.CdccInput
  data premium_tax_credit content Calc.PtcInput
  data screening content ApiScreening

## The response `outcome`.
declaration enumeration ApiOutcome:
  -- Refund
  -- BalanceDue
  -- Even

## One entry of the response `reasons`: the knockout that fired and its category.
declaration structure ApiReason:
  data code content Calc.CalculatorKnockout
  data category content AR.ApiReasonCategory

## The response `lines`: one entry per scalar Form 1040 line item of
## `api/line-catalog.json`, in dollars (the wire carries cents).
declaration structure ApiLines:
  data wages content money
  data employer_income_subtotal content money
  data interest_income content money
  data total_income content money
  data adjustments_to_income content money
  data agi content money
  data standard_or_itemized_deductions content money
  data total_deductions content money
  data taxable_income content money
  data tentative_tax_from_taxable_income content money
  data total_tentative_tax content money
  data non_refundable_credits content money
  data tax_less_non_refundable_credits content money
  data total_tax content money
  data total_withholding content money
  data total_other_payments_refundable_credits content money
  data total_payments content money
  data overpayment content money
  data balance_due content money

## `outcome` of a supported return from lines 34 and 37 (Form 1040):
## `Refund` if line 34 is positive, `BalanceDue` if line 37 is positive, else `Even`.
declaration scope OutcomeOf:
  input overpayment content money
  input balance_due content money
  output outcome content ApiOutcome

## The marital status of the request, defaulted from the filing status when the
## request leaves it unspecified.
declaration scope MaritalOf:
  input filing_status content Types.FilingStatus
  input marital_status content ApiMaritalStatus
  input year_of_spouse_death content ApiYearOfSpouseDeath
  input is_widowed_in_tax_year content boolean
  output marital_status_used content F.MaritalStatus
  output year_of_spouse_death_used content F.YearOfSpouseDeath

## One filer's answers, with the legacy flags folded in.
declaration scope ApiFilerToCalc:
  input api content ApiFiler
  # `filing_details.treat_filers_as_dependents`
  input treat_as_dependent content boolean
  # the legacy 65-or-older flag for the spouse (`mfj_deceased_spouse_reached_age65`)
  input also_age65 content boolean
  output answers content F.FilerAnswers
  output extra content Calc.FilerExtra

declaration scope ApiDependentToCalc:
  input api content ApiDependent
  output member content Calc.HouseholdMember

declaration scope ApiCalculator:
  input request content ApiRequest

  internal primary content ApiFilerToCalc
  internal secondary content ApiFilerToCalc
  internal marital content MaritalOf
  internal calc content Calc.Calculator

  output supported content boolean
  output outcome content ApiOutcome
  output reasons content list of ApiReason
  output lines content ApiLines
```

```catala
scope OutcomeOf:
  definition outcome equals
    if overpayment > $0 then Refund
    else if balance_due > $0 then BalanceDue
    else Even

scope MaritalOf:
  definition marital_status_used equals
    match marital_status with pattern
    -- NeverMarried: F.MaritalStatus.NeverMarried
    -- Married: F.MaritalStatus.Married
    -- Divorced: F.MaritalStatus.Divorced
    -- Widowed: F.MaritalStatus.Widowed
    -- ApiMaritalStatus.Unspecified:
         (if is_widowed_in_tax_year then F.MaritalStatus.Widowed
          else match filing_status with pattern
               -- Single: F.MaritalStatus.NeverMarried
               -- HeadOfHousehold: F.MaritalStatus.NeverMarried
               -- MarriedFilingJointly: F.MaritalStatus.Married
               -- MarriedFilingSeparately: F.MaritalStatus.Married
               -- QualifyingSurvivingSpouse: F.MaritalStatus.Widowed)
  definition year_of_spouse_death_used equals
    match year_of_spouse_death with pattern
    -- DiedInTaxYear: F.YearOfSpouseDeath.DiedInTaxYear
    -- DiedTaxYearMinusOne: F.YearOfSpouseDeath.DiedTaxYearMinusOne
    -- DiedTaxYearMinusTwo: F.YearOfSpouseDeath.DiedTaxYearMinusTwo
    -- DiedBeforeTaxYearMinusTwo: F.YearOfSpouseDeath.DiedBeforeTaxYearMinusTwo
    -- ApiYearOfSpouseDeath.Unspecified:
         (if is_widowed_in_tax_year then F.YearOfSpouseDeath.DiedInTaxYear
          else if filing_status = Types.FilingStatus.QualifyingSurvivingSpouse
          then F.YearOfSpouseDeath.DiedTaxYearMinusOne
          else F.YearOfSpouseDeath.DiedBeforeTaxYearMinusTwo)

scope ApiFilerToCalc:
  definition answers equals F.FilerAnswers {
    -- date_of_birth:
         (if api.date_of_birth_given then api.date_of_birth
          else if api.age65_or_older or also_age65 then |1950-06-15|
          else |1985-06-15|)
    -- is_blind: api.is_blind
    -- can_be_claimed: api.can_be_claimed_as_dependent or treat_as_dependent
    -- will_be_claimed: api.will_be_claimed or treat_as_dependent
    -- potential_claimer_must_file: api.potential_claimer_must_file or treat_as_dependent
    -- potential_claimer_did_file: api.potential_claimer_did_file
    -- is_us_citizen_full_year: api.is_us_citizen_full_year
    -- writable_citizen_at_end_of_tax_year: api.citizen_at_end_of_tax_year
    -- writable_is_noncitizen_resident_full_year: api.noncitizen_resident_full_year
    -- writable_is_national: api.is_national }
  definition extra equals Calc.FilerExtra {
    -- tin: api.tin
    -- is_student: api.is_student
    -- disability: api.disability
    -- hsa: api.hsa
    -- cdcc: api.cdcc }

scope ApiDependentToCalc:
  definition member equals Calc.HouseholdMember {
    -- dependent: QR.Member {
         -- person: Q.Person {
              -- relationship: api.relationship
              -- date_of_birth: api.date_of_birth
              -- full_time_student: api.full_time_student
              -- permanent_total_disability: api.permanent_total_disability
              -- residency_duration: api.residency_duration
              -- own_support: api.own_support
              -- married: api.married
              -- writable_joint_return: api.joint_return
              -- writable_required_to_file: api.required_to_file
              -- writable_filing_only_for_refund: api.filing_only_for_refund
              -- writable_could_be_qualifying_child_of_another:
                   api.could_be_qualifying_child_of_another
              -- writable_potential_claimer_must_file: api.potential_claimer_must_file
              -- writable_potential_claimer_did_file: api.potential_claimer_did_file
              -- writable_potential_claimer_filed_only_for_refund:
                   api.potential_claimer_filed_only_for_refund }
         -- answers: QR.DependentAnswers {
              -- gross_income: api.gross_income
              -- writable_qr_support_test: api.qr_support_test
              -- tin_type: api.tin_type
              -- is_us_citizen_full_year: api.is_us_citizen_full_year
              -- writable_us_resident: api.us_resident
              -- writable_us_national: api.us_national
              -- writable_canada_mexico_resident: api.canada_mexico_resident
              -- tp_claims: api.tp_claims }
         -- split: api.custody }
    -- upkeep: HQ.UpkeepAnswers {
         -- tp_paid_most_of_home_upkeep: api.tp_paid_most_of_home_upkeep
         -- tp_paid_most_of_parent_home_upkeep: api.tp_paid_most_of_parent_home_upkeep }
    -- ssn_employment_validity: api.ssn_employment_validity
    -- ssn_only_for_federally_funded_benefit: api.ssn_only_for_federally_funded_benefit
    -- months_lived_with_tp_in_us: api.months_lived_with_tp_in_us
    -- cdcc: api.cdcc }

scope ApiCalculator:
  definition primary equals output of ApiFilerToCalc with {
    -- api: request.filers.primary
    -- treat_as_dependent: request.filing_details.treat_filers_as_dependents
    -- also_age65: false }
  definition secondary equals output of ApiFilerToCalc with {
    -- api: request.filers.secondary
    -- treat_as_dependent: request.filing_details.treat_filers_as_dependents
    -- also_age65: request.filing_details.mfj_deceased_spouse_reached_age65 }
  definition marital equals output of MaritalOf with {
    -- filing_status: request.filing_status
    -- marital_status: request.filing_answers.marital_status
    -- year_of_spouse_death: request.filing_answers.year_of_spouse_death
    -- is_widowed_in_tax_year: request.filing_details.is_widowed_in_tax_year }

  definition calc equals output of Calc.Calculator with {
    -- filing_status: request.filing_status
    -- filers: Calc.FilersInput {
         -- marital_status: marital.marital_status_used
         -- year_of_spouse_death: marital.year_of_spouse_death_used
         -- primary_filer: primary.answers
         -- secondary_filer: secondary.answers
         -- secondary_filer_date_of_death: request.filing_answers.secondary_filer_date_of_death
         -- primary_filer_potential_claimer_filed_only_for_refund:
              request.filing_answers.primary_filer_potential_claimer_filed_only_for_refund
         -- mfj_required_to_file: request.filing_answers.mfj_required_to_file
         -- mfj_dependents_filing_for_credits: request.filing_answers.mfj_dependents_filing_for_credits
         -- lived_together_all_year_with_spouse:
              request.filing_answers.lived_together_all_year_with_spouse
              and not request.social_security.lived_apart_all_year
         -- spouse_lived_together_months:
              (if request.social_security.lived_apart_all_year
               then F.SpouseLivedTogetherMonths.LivedApartAllYear
               else request.filing_answers.spouse_lived_together_months)
         -- writable_lived_apart_last_six_months: request.filing_answers.lived_apart_last_six_months
         -- writable_separation_agreement: request.filing_answers.separation_agreement
         -- can_file_jointly_year_of_spouse_death:
              request.filing_answers.can_file_jointly_year_of_spouse_death
              or request.filing_status = Types.FilingStatus.QualifyingSurvivingSpouse
         -- in_registered_domestic_partnership: request.filing_answers.in_registered_domestic_partnership
         -- filer_residence_and_income_state: request.filing_answers.residence_state
         -- spouse_itemizes: request.filing_answers.spouse_itemizes
         -- mfs_living_spouse_filing_return: request.filing_answers.mfs_living_spouse_filing_return
         -- mfs_deceased_spouse_filing_return: request.filing_answers.mfs_deceased_spouse_filing_return
         -- mfs_spouse_has_gross_income:
              request.filing_answers.mfs_spouse_has_gross_income
              or request.filing_details.mfs_spouse_provides_no_benefits
         -- mfs_spouse_65_or_older: request.filing_details.mfs_spouse_65_or_older }
    -- primary_extra: primary.extra
    -- secondary_extra: secondary.extra
    -- household: map each d among request.dependents to
         (output of ApiDependentToCalc with { -- api: d }).member
    -- income: Calc.IncomeInput {
         -- w2s: map each x among request.w2s to (output of ApiW2ToCalc with { -- api: x }).w2
         -- combat_pay_election: request.filing_details.combat_pay_election
         -- combat_pay_election_made:
              request.filing_details.combat_pay_election_made
              or request.filing_details.combat_pay_election != W.CombatPayElection.NoCombatPay
         -- interest_reports: map each x among request.interest_reports to
              (output of ApiInterestToCalc with { -- api: x }).form
         -- form_1099gs: map each x among request.form_1099g to
              (output of ApiForm1099GToCalc with { -- api: x }).form
         -- form_1099miscs: map each x among request.form_1099misc to
              (output of ApiForm1099MiscToCalc with { -- api: x }).form
         -- form_1099rs: map each x among request.form_1099r to
              (output of ApiForm1099RToCalc with { -- api: x }).form
         -- ssa_net_benefits: request.social_security.net_benefits
         -- ssa_federal_tax_withheld: request.social_security.federal_tax_withheld }
    -- adjustments: Calc.AdjustmentsInput {
         -- was_k12_educators: request.adjustments.educator_expenses.was_k12_educators
         -- primary_educator_expenses_writable: request.adjustments.educator_expenses.primary_expenses
         -- secondary_educator_expenses_writable:
              request.adjustments.educator_expenses.secondary_expenses
         -- had_student_loan_interest_payments: request.adjustments.student_loan_interest.had_payments
         -- student_loans_qualify: request.adjustments.student_loan_interest.loans_qualify
         -- student_loan_interest_amount: request.adjustments.student_loan_interest.interest_amount
         -- hsa: request.adjustments.hsa }
    -- payments: Calc.PaymentsInput {
         -- paid_estimated_taxes_or_from_last_year:
              request.estimated_payments.paid_estimated_taxes_or_from_last_year
         -- estimated_tax_payment_writable: request.estimated_payments.amount
         -- paid_estimated_taxes_or_from_last_year_under_different_name:
              request.estimated_payments.paid_under_different_name
         -- paid_estimated_taxes_with_former_spouse: request.estimated_payments.paid_with_former_spouse }
    -- credits: request.credits
    -- cdcc_answers: request.cdcc
    -- ptc_answers: request.premium_tax_credit
    -- screening: Calc.ScreeningAnswers {
         -- member_vitals: map each d among request.dependents to
              KH.MemberVitals { -- date_of_birth: d.date_of_birth -- deceased: d.deceased
                                -- has_tin_type_none: d.tin_type = QR.TinType.NoTin }
         -- income_sources_supported: request.screening.income_sources_supported
         -- received_digital_assets: request.screening.received_digital_assets
         -- disposed_digital_assets: request.screening.disposed_digital_assets
         -- is_foreign_trusts_grantor: request.screening.is_foreign_trusts_grantor
         -- has_foreign_trusts_transactions: request.screening.has_foreign_trusts_transactions
         -- made_ira_contributions: request.screening.made_ira_contributions
         -- w2_box15_income_from_different_state: request.screening.w2_box15_income_from_different_state
         -- w2_has_box14_nyrrta_knockout_code: request.screening.w2_has_box14_nyrrta_knockout_code
         -- w2_has_rrta_codes_in_box14: request.screening.w2_has_rrta_codes_in_box14
         -- lived_in_ny: request.screening.lived_in_ny
         -- w2_paid_yonkers_taxes: request.screening.w2_paid_yonkers_taxes
         -- part_year_yonkers_resident: request.screening.part_year_yonkers_resident
         -- primary_filer_forms_another_state: request.screening.primary_filer_forms_another_state
         -- received_alaska_pfd: request.screening.received_alaska_pfd
         -- spouse_received_alaska_pfd: request.screening.spouse_received_alaska_pfd
         -- spouse_lives_in_other_or_multiple_states: request.screening.spouse_lives_in_other_or_multiple_states
         -- spouse_forms_another_state: request.screening.spouse_forms_another_state
         -- is_after_tax_day_and_not_resubmitting: request.screening.is_after_tax_day_and_not_resubmitting
         -- is_after_resubmission_deadline: request.screening.is_after_resubmission_deadline
         -- has_foreign_accounts:
              request.screening.has_foreign_accounts
              or request.filing_details.has_foreign_accounts_or_trusts } }

  definition supported equals not calc.unsupported

  definition reasons equals
    if calc.unsupported
    then map each k among calc.fired_knockouts to
           ApiReason { -- code: k -- category: (output of AR.ApiReasonCategoryOf with { -- reason: k }).category }
    else []

  # An unsupported return has no lines (the response is HTTP 422): all zero.
  definition lines equals
    if calc.unsupported
    then ApiLines {
      -- wages: $0 -- employer_income_subtotal: $0 -- interest_income: $0 -- total_income: $0
      -- adjustments_to_income: $0 -- agi: $0 -- standard_or_itemized_deductions: $0
      -- total_deductions: $0 -- taxable_income: $0 -- tentative_tax_from_taxable_income: $0
      -- total_tentative_tax: $0 -- non_refundable_credits: $0 -- tax_less_non_refundable_credits: $0
      -- total_tax: $0 -- total_withholding: $0 -- total_other_payments_refundable_credits: $0
      -- total_payments: $0 -- overpayment: $0 -- balance_due: $0 }
    else ApiLines {
      -- wages: calc.wages
      -- employer_income_subtotal: calc.employer_income_subtotal
      -- interest_income: calc.interest_income
      -- total_income: calc.total_income
      -- adjustments_to_income: calc.adjustments_to_income
      -- agi: calc.agi
      -- standard_or_itemized_deductions: calc.standard_or_itemized_deductions
      -- total_deductions: calc.total_deductions
      -- taxable_income: calc.taxable_income
      -- tentative_tax_from_taxable_income: calc.tentative_tax_from_taxable_income
      -- total_tentative_tax: calc.total_tentative_tax
      -- non_refundable_credits: calc.non_refundable_credits
      -- tax_less_non_refundable_credits: calc.tax_less_non_refundable_credits
      -- total_tax: calc.total_tax
      -- total_withholding: calc.total_withholding
      -- total_other_payments_refundable_credits: calc.total_other_payments_refundable_credits
      -- total_payments: calc.total_payments
      -- overpayment: calc.overpayment
      -- balance_due: calc.balance_due }

  definition outcome equals
    if calc.unsupported then Even
    else (output of OutcomeOf with {
            -- overpayment: calc.overpayment
            -- balance_due: calc.balance_due }).outcome
```
