  output ko_qualifying_child_tie_breaker condition
  output ko_claimed_spouse_combat_pay_without_mfj condition
  output ko_filing_status_not_eligible condition
  output ko_sole_proprietorship_benefits condition
  output ko_both_spouses_deemed_income condition
  output ko_tp_needs_to_add1095_a condition
  output ko_tp_needs_to_delete1095_a condition
  output unsupported_household condition
  internal knockout_table content list of KI.KnockoutEntry
  output fired_knockouts content list of KI.KnockoutReason
```

## Rules

Knockout (`familyAndHousehold.xml` line 668): "The person was born and died
in the tax year, and never received a TIN. This person is not supported by
direct file." A member is born in the tax year when the year of the date of
birth is 2024, died when `deceased`, and has no TIN when the TIN type is
`none`. (Pub. 501 p 23 allows such a child to be claimed with a birth
certificate and no SSN; the return would need attachments DF does not send.)

```catala
scope KnockoutsHousehold:
  # DF: /familyAndHousehold/*/bornAndDiedInTaxYearWithoutTin, counted
  rule ko_knockout_person_born_and_died_in_tax_year_without_tin under condition
    exists m among member_vitals such that
      Date.get_year of m.date_of_birth = F.tax_year
      and m.deceased and m.has_tin_type_none
  consequence fulfilled

  rule ko_flow_knockout_filer_age_younger_than16 under condition in_flow_knockout_filer_age_younger_than16
  consequence fulfilled
  rule ko_spouse_itemizes_knockout under condition in_spouse_itemizes_knockout
  consequence fulfilled
  rule ko_primary_filer_residency_knockout under condition in_primary_filer_residency_knockout
  consequence fulfilled
  rule ko_flow_knockout_has_applicable_registered_domestic_partnership under condition in_flow_knockout_has_applicable_registered_domestic_partnership
  consequence fulfilled
  rule ko_knockout_subject_to_community_property_laws under condition in_knockout_subject_to_community_property_laws
  consequence fulfilled
  rule ko_knockout_hoh_qp_has_no_tin under condition in_knockout_hoh_qp_has_no_tin
  consequence fulfilled
  rule ko_knocked_out_by_non_custodial_parent_benefit_split under condition in_knocked_out_by_non_custodial_parent_benefit_split
  consequence fulfilled
  rule ko_knocked_out_by_contradictory8832 under condition in_knocked_out_by_contradictory8832
  consequence fulfilled
  rule ko_savers_credit_knockouts under condition in_savers_credit_knockouts
  consequence fulfilled
  rule ko_flow_knockout_benefits_distribution under condition in_flow_knockout_benefits_distribution
  consequence fulfilled
  rule ko_knockout_cdcc_worksheet_a under condition in_knockout_cdcc_worksheet_a
  consequence fulfilled
  rule ko_flow_knockout_household_employee under condition in_flow_knockout_household_employee
  consequence fulfilled
  rule ko_dependent_tp_requires_allocations under condition in_dependent_tp_requires_allocations
  consequence fulfilled
  rule ko_has_ptc_qualifying_plan_and_qsehra under condition in_has_ptc_qualifying_plan_and_qsehra
  consequence fulfilled
  rule ko_needs_allocations under condition in_needs_allocations
  consequence fulfilled
  rule ko_has_employer_sponsored_plan under condition in_has_employer_sponsored_plan
  consequence fulfilled
  rule ko_dependents_required_to_file under condition in_dependents_required_to_file
  consequence fulfilled
  rule ko_self_reported_has_multiple1095_as under condition in_self_reported_has_multiple1095_as
  consequence fulfilled
  rule ko_has_immigration_status_not_eligible_for_marketplace under condition in_has_immigration_status_not_eligible_for_marketplace
  consequence fulfilled
  rule ko_wants_to_use_alt_calculations under condition in_wants_to_use_alt_calculations
  consequence fulfilled
  rule ko_qualifying_child_tie_breaker under condition in_qualifying_child_tie_breaker
  consequence fulfilled
  rule ko_claimed_spouse_combat_pay_without_mfj under condition in_claimed_spouse_combat_pay_without_mfj
  consequence fulfilled
  rule ko_filing_status_not_eligible under condition in_filing_status_not_eligible
  consequence fulfilled
  rule ko_sole_proprietorship_benefits under condition in_sole_proprietorship_benefits
  consequence fulfilled
  rule ko_both_spouses_deemed_income under condition in_both_spouses_deemed_income
  consequence fulfilled
  rule ko_tp_needs_to_add1095_a under condition in_tp_needs_to_add1095_a
  consequence fulfilled
  rule ko_tp_needs_to_delete1095_a under condition in_tp_needs_to_delete1095_a
  consequence fulfilled

  definition knockout_table equals [
    KI.KnockoutEntry {
      -- reason: KI.KnockoutReason.KnockoutPersonBornAndDiedInTaxYearWithoutTin
      -- fired: ko_knockout_person_born_and_died_in_tax_year_without_tin }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.FlowKnockoutFilerAgeYoungerThan16 -- fired: ko_flow_knockout_filer_age_younger_than16 }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.SpouseItemizesKnockout -- fired: ko_spouse_itemizes_knockout }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.PrimaryFilerResidencyKnockout -- fired: ko_primary_filer_residency_knockout }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.FlowKnockoutHasApplicableRegisteredDomesticPartnership -- fired: ko_flow_knockout_has_applicable_registered_domestic_partnership }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.KnockoutSubjectToCommunityPropertyLaws -- fired: ko_knockout_subject_to_community_property_laws }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.KnockoutHohQpHasNoTin -- fired: ko_knockout_hoh_qp_has_no_tin }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.KnockedOutByNonCustodialParentBenefitSplit -- fired: ko_knocked_out_by_non_custodial_parent_benefit_split }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.KnockedOutByContradictory8832 -- fired: ko_knocked_out_by_contradictory8832 }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.SaversCreditKnockouts -- fired: ko_savers_credit_knockouts }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.FlowKnockoutBenefitsDistribution -- fired: ko_flow_knockout_benefits_distribution }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.KnockoutCdccWorksheetA -- fired: ko_knockout_cdcc_worksheet_a }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.FlowKnockoutHouseholdEmployee -- fired: ko_flow_knockout_household_employee }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.DependentTpRequiresAllocations -- fired: ko_dependent_tp_requires_allocations }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.HasPtcQualifyingPlanAndQsehra -- fired: ko_has_ptc_qualifying_plan_and_qsehra }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.NeedsAllocations -- fired: ko_needs_allocations }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.HasEmployerSponsoredPlan -- fired: ko_has_employer_sponsored_plan }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.DependentsRequiredToFile -- fired: ko_dependents_required_to_file }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.SelfReportedHasMultiple1095As -- fired: ko_self_reported_has_multiple1095_as }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.HasImmigrationStatusNotEligibleForMarketplace -- fired: ko_has_immigration_status_not_eligible_for_marketplace }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.WantsToUseAltCalculations -- fired: ko_wants_to_use_alt_calculations }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.ExtraQualifyingChildTieBreaker -- fired: ko_qualifying_child_tie_breaker }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.ExtraClaimedSpouseCombatPayWithoutMfj -- fired: ko_claimed_spouse_combat_pay_without_mfj }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.ExtraFilingStatusNotEligible -- fired: ko_filing_status_not_eligible }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.ExtraCdccSoleProprietorshipBenefits -- fired: ko_sole_proprietorship_benefits }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.ExtraCdccBothSpousesDeemedIncome -- fired: ko_both_spouses_deemed_income }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.ExtraTpNeedsToAdd1095A -- fired: ko_tp_needs_to_add1095_a }
    ; KI.KnockoutEntry { -- reason: KI.KnockoutReason.ExtraTpNeedsToDelete1095A -- fired: ko_tp_needs_to_delete1095_a }
  ]

  definition fired_knockouts equals
    map each e among (list of e among knockout_table such that e.fired) to e.reason

  rule unsupported_household under condition
    ko_knockout_person_born_and_died_in_tax_year_without_tin
    or ko_flow_knockout_filer_age_younger_than16
    or ko_spouse_itemizes_knockout
    or ko_primary_filer_residency_knockout
    or ko_flow_knockout_has_applicable_registered_domestic_partnership
    or ko_knockout_subject_to_community_property_laws
    or ko_knockout_hoh_qp_has_no_tin
    or ko_knocked_out_by_non_custodial_parent_benefit_split
    or ko_knocked_out_by_contradictory8832
    or ko_savers_credit_knockouts
    or ko_flow_knockout_benefits_distribution
    or ko_knockout_cdcc_worksheet_a
    or ko_flow_knockout_household_employee
    or ko_dependent_tp_requires_allocations
    or ko_has_ptc_qualifying_plan_and_qsehra
    or ko_needs_allocations
    or ko_has_employer_sponsored_plan
    or ko_dependents_required_to_file
    or ko_self_reported_has_multiple1095_as
    or ko_has_immigration_status_not_eligible_for_marketplace
    or ko_wants_to_use_alt_calculations
    or ko_qualifying_child_tie_breaker
    or ko_claimed_spouse_combat_pay_without_mfj
    or ko_filing_status_not_eligible
    or ko_sole_proprietorship_benefits
    or ko_both_spouses_deemed_income
    or ko_tp_needs_to_add1095_a
    or ko_tp_needs_to_delete1095_a
  consequence fulfilled
```
