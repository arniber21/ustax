      -- mfj_deceased_spouse_reached_age65: base.mfj_deceased_spouse_reached_age65
      -- mfs_spouse_65_or_older: base.mfs_spouse_65_or_older
      -- mfs_spouse_provides_no_benefits: base.mfs_spouse_provides_no_benefits
      -- treat_filers_as_dependents: base.treat_filers_as_dependents
      -- taxable_dependent_care: slots.taxable_dependent_care
      -- taxable_pensions_and_annuities: slots.taxable_pensions_and_annuities
      -- taxable_social_security_benefits: slots.taxable_social_security_benefits
      -- unemployment_compensation: slots.unemployment_compensation
      -- alaska_pfd_income: slots.alaska_pfd_income
      -- student_loan_interest_adjustment_amount: slots.student_loan_interest_adjustment_amount
      -- educator_expenses_adjustment: slots.educator_expenses_adjustment
      -- hsa_total_deductible_amount: slots.hsa_total_deductible_amount
      -- total_additional_taxes_owed: slots.total_additional_taxes_owed
      -- total_ctc_and_odc: slots.total_ctc_and_odc
      -- line8_of_schedule3: slots.line8_of_schedule3
      -- other_1099_withholding: slots.other_1099_withholding
      -- paid_estimated_taxes_or_from_last_year: slots.paid_estimated_taxes_or_from_last_year
      -- estimated_and_from_last_year: slots.estimated_and_from_last_year
      -- earned_income_credit: slots.earned_income_credit
      -- additional_ctc: slots.additional_ctc
